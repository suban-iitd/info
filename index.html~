    { t: "On Facebook's Freebasics", a: "Subhashis Banerjee", v: "Blog", d: "January 2016", link: "http://www.cse.iitd.ac.in/~suban/reports/freebasics.pdf" }
  ];

  /* ---------------- RENDER: RESEARCH ---------------- */

  const CATEGORY_COLORS = {
    privacy: 'var(--c-privacy)',
    tai: 'var(--c-tai)',
    voting: 'var(--c-voting)',
    radiology: 'var(--c-radiology)',
    vision: 'var(--c-vision)'
  };

  const filterRow = document.getElementById('filterRow');
  const researchContainer = document.getElementById('researchContainer');

  const allPill = document.createElement('a');
  allPill.href = '#research';
  allPill.className = 'filter-pill';
  allPill.textContent = 'All areas';
  allPill.addEventListener('click', () => openAll());
  filterRow.appendChild(allPill);

  RESEARCH.forEach(cat => {
    const pill = document.createElement('a');
    pill.href = '#cat-' + cat.key;
    pill.className = 'filter-pill';
    pill.style.setProperty('--cat-color', CATEGORY_COLORS[cat.key]);
    pill.innerHTML = `<span class="dot"></span>${cat.label}`;
    pill.addEventListener('click', (e) => {
      document.querySelectorAll('.research-card').forEach(c => c.open = (c.id === 'cat-' + cat.key));
    });
    filterRow.appendChild(pill);

    const card = document.createElement('details');
    card.className = 'research-card';
    card.id = 'cat-' + cat.key;
    card.style.setProperty('--cat-color', CATEGORY_COLORS[cat.key]);
    if (cat.key === 'privacy') card.open = true;

    const summary = document.createElement('summary');
    summary.innerHTML = `
      <div class="summary-text">
        <span class="dot"></span>
        <h3>${cat.title}</h3>
      </div>
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    `;
    card.appendChild(summary);

    const body = document.createElement('div');
    body.className = 'research-body';
    const blurb = document.createElement('p');
    blurb.className = 'research-blurb';
    blurb.textContent = cat.blurb;
    body.appendChild(blurb);

    const list = document.createElement('ul');
    list.className = 'pub-list';
    cat.pubs.forEach(p => {
      const li = document.createElement('li');
      const linkHtml = p.link ? ` · <a href="${p.link}" target="_blank" rel="noopener">${p.linkLabel || 'Link'}</a>` : '';
      li.innerHTML = `<span class="pub-title">${p.t}</span><span class="pub-meta">${p.a} — ${p.v}, ${p.d}${linkHtml}</span>`;
      list.appendChild(li);
    });
    body.appendChild(list);
    card.appendChild(body);
    researchContainer.appendChild(card);
  });

  function openAll(){
    document.querySelectorAll('.research-card').forEach(c => c.open = true);
  }

  /* ---------------- RENDER: COURSES ---------------- */

  document.getElementById('courseSemester').textContent = CURRENT_SEMESTER;

  const currentCoursesEl = document.getElementById('currentCourses');
  COURSES_CURRENT.forEach(c => {
    const row = document.createElement('div');
    row.className = 'current-course';
    row.innerHTML = `<a href="${c.link}" target="_blank" rel="noopener">${c.t} ↗</a>`;
    currentCoursesEl.appendChild(row);
  });

  const taughtEl = document.getElementById('taughtCourses');
  COURSES_TAUGHT.forEach(c => {
    const li = document.createElement('li');
    li.textContent = c;
    taughtEl.appendChild(li);
  });

  /* ---------------- RENDER: COMMENTARIES ---------------- */

  const commentaryListEl = document.getElementById('commentaryList');
  const searchInput = document.getElementById('commentarySearch');
  const noResultsEl = document.getElementById('noResults');
  const loadMoreRow = document.getElementById('loadMoreRow');
  const loadMoreBtn = document.getElementById('loadMoreBtn');

  const INITIAL_COUNT = 10;
  let showAll = false;

  function renderCommentaries(){
    const query = searchInput.value.trim().toLowerCase();
    const filtered = COMMENTARIES.filter(c =>
      (c.t + ' ' + c.v + ' ' + c.d + ' ' + c.a).toLowerCase().includes(query)
    );

    const isFiltering = query.length > 0;
    const visible = (showAll || isFiltering) ? filtered : filtered.slice(0, INITIAL_COUNT);

    commentaryListEl.innerHTML = '';
    visible.forEach(c => {
      const li = document.createElement('li');
      li.className = 'commentary-item';
      const titleHtml = c.link
        ? `<a href="${c.link}" target="_blank" rel="noopener">${c.t}</a>`
        : c.t;
      li.innerHTML = `<span class="c-title">${titleHtml}</span><span class="c-meta">${c.d} · ${c.v}${c.a && c.a !== 'Subhashis Banerjee' ? ' · ' + c.a : ''}</span>`;
      commentaryListEl.appendChild(li);
    });

    noResultsEl.hidden = filtered.length !== 0;
    loadMoreRow.style.display = (isFiltering || showAll || filtered.length <= INITIAL_COUNT) ? 'none' : 'block';
  }

  searchInput.addEventListener('input', renderCommentaries);
  loadMoreBtn.addEventListener('click', () => { showAll = true; renderCommentaries(); });
  renderCommentaries();

  /* ---------------- NAV: mobile toggle ---------------- */

  const sidebar = document.getElementById('sidebar');
  const navToggle = document.getElementById('navToggle');
  const scrim = document.getElementById('scrim');

  function closeNav(){
    sidebar.classList.remove('open');
    navToggle.classList.remove('open');
    navToggle.setAttribute('aria-expanded', 'false');
    scrim.classList.remove('show');
  }
  function openNav(){
    sidebar.classList.add('open');
    navToggle.classList.add('open');
    navToggle.setAttribute('aria-expanded', 'true');
    scrim.classList.add('show');
  }
  navToggle.addEventListener('click', () => {
    sidebar.classList.contains('open') ? closeNav() : openNav();
  });
  scrim.addEventListener('click', closeNav);
  document.querySelectorAll('#navList a').forEach(a => a.addEventListener('click', closeNav));

  /* ---------------- NAV: scrollspy ---------------- */

  const navLinks = document.querySelectorAll('[data-nav]');
  const sections = ['about','research','courses','commentaries','contact'].map(id => document.getElementById(id));

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting){
        const id = entry.target.id;
        navLinks.forEach(l => l.classList.toggle('active', l.getAttribute('href') === '#' + id));
      }
    });
  }, { rootMargin: '-40% 0px -50% 0px', threshold: 0 });

  sections.forEach(s => s && observer.observe(s));

  /* ---------------- EMAIL: no plain mailto: link, built at runtime ---------------- */

  const EMAIL_PARTS = ['suban', 'ashoka.edu.in'];
  const EMAIL = EMAIL_PARTS.join('@');
  const EMAIL_DISPLAY = EMAIL_PARTS[0] + ' [at] ' + EMAIL_PARTS[1].replace('.', ' [dot] ');

  document.querySelectorAll('[data-email-slot]').forEach(el => { el.textContent = EMAIL_DISPLAY; });

  document.querySelectorAll('[data-copy-email]').forEach(btn => {
    const originalLabel = btn.textContent;
    btn.addEventListener('click', async () => {
      try{
        await navigator.clipboard.writeText(EMAIL);
        btn.textContent = 'Copied!';
      }catch(e){
        btn.textContent = EMAIL;
      }
      setTimeout(() => { btn.textContent = originalLabel; }, 1800);
    });
  });

})();
</script>
</body>
</html>
