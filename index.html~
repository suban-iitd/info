    { t: "Where goes Aadhaar?", a: "Subhashis Banerjee", v: "The Indian Express", d: "15 July 2019", link: "https://indianexpress.com/article/opinion/columns/aadhaar-amendment-bill-new-rules-uidai-5829226/" },
