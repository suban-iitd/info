    { t: "An offline alternative for Aadhaar-based biometric authentication", a: "Subhashis Banerjee, Subodh Sharma", v: "Ideas for India", d: "September 2018", link: "http://www.ideasforindia.in/topics/productivity-innovation/an-offline-alternative-for-aadhaar-based-biometric-authentication.html" },
    { t: "Authorisation and access control architecture as a framework for data and privacy protection", a: "Subhashis Banerjee", v: "Submitted to the B. N. Srikrishna committee; summarised in The Indian Express", d: "April 2018", link: "https://arxiv.org/abs/1801.05313" },
    { t: "Interview with Governance Now", a: "Subhashis Banerjee", v: "Governance Now", d: "31 January 2018", link: "http://www.governancenow.com/views/interview/virtual-id-is-a-good-beginning-much-more-remains-to-be-done" },
    { t: "Aadhaar needs to pass a stringent welfare test", a: "Subhashis Banerjee", v: "The Indian Express", d: "November 2017", link: "http://indianexpress.com/article/opinion/columns/a-welfare-test-for-aadhaar-upa-nda-aadhaar-card-4921582/" },
