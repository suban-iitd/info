    { t: "It's time to disentangle the complex Aadhaar debate", a: "Subhashis Banerjee", v: "The Wire", d: "April 2017", link: "https://thewire.in/126115/aadhar-privacy-analysis/" },
    { t: "A contentious proposal", a: "Subhashis Banerjee", v: "The Indian Express", d: "January 2017", link: "http://indianexpress.com/article/opinion/columns/poverty-alleviation-universal-basic-income-ubi-direct-benefit-transfer-dbt-black-money-mgnrega-a-contentious-proposal-4473170/" },
    { t: "There is No Magical On-Off Switch That Will Allow India to Transform Into a Cashless Economy", a: "Subhashis Banerjee", v: "The Wire / Business Standard", d: "December 2016", link: "http://thewire.in/86893/no-off-switch-will-allow-india-magically-migrate-cashless-economy/" },
